# Copie para .env e ajuste. Nunca versione o .env (ver .claude/rules/frontend/security-frontend.md).
# Tudo com prefixo VITE_ vai para o bundle e fica público: segredo de verdade não pertence ao front.

# Base das chamadas HTTP (axios). Em dev o Vite faz proxy de /api para VITE_API_PROXY_TARGET.
VITE_API_URL=/api

# Alvo do proxy de desenvolvimento (Api .NET local).
VITE_API_PROXY_TARGET=https://localhost:7180
