{
   "name": "personalprospec-front",
   "private": true,
   "version": "0.1.0",
   "type": "module",
   "scripts": {
      "dev": "vite",
      "build": "tsc -b && vite build",
      "preview": "vite preview",
      "ts:check": "tsc -b",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "lint": "eslint .",
      "test:unit": "vitest run tests/unit",
      "test:integration": "vitest run tests/integration --passWithNoTests",
      "test:coverage": "vitest run tests/unit tests/integration --coverage",
      "test:e2e": "playwright test --grep-invert @real-api",
      "test:e2e:real-api": "playwright test --grep @real-api",
      "storybook": "storybook dev -p 6006",
      "build-storybook": "storybook build"
   },
   "dependencies": {
      "@hookform/resolvers": "^5.7.1",
      "@reduxjs/toolkit": "^2.12.0",
      "axios": "^1.13.2",
      "inversify": "^8.2.3",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-hook-form": "^7.71.1",
      "react-redux": "^9.3.0",
      "react-router-dom": "^7.18.2",
      "reflect-metadata": "^0.2.2",
      "styled-components": "^6.1.19",
      "zod": "^4.4.3"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.5",
      "@playwright/test": "^1.58.2",
      "@storybook/addon-a11y": "^10.5.10",
      "@storybook/addon-docs": "^10.5.10",
      "@storybook/addon-mcp": "^0.7.0",
      "@storybook/addon-vitest": "^10.5.10",
      "@storybook/react-vite": "^10.5.10",
      "@testing-library/react": "^16.3.2",
      "@types/node": "^22.19.3",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.5",
      "@vitest/browser-playwright": "4.1.10",
      "@vitest/coverage-v8": "4.1.10",
      "eslint": "^9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-playwright": "^2.5.1",
      "eslint-plugin-prettier": "^5.5.4",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-plugin-react-refresh": "^0.4.26",
      "eslint-plugin-storybook": "^10.5.10",
      "globals": "^16.5.0",
      "jsdom": "^29.0.1",
      "playwright": "^1.64.1",
      "prettier": "^3.9.10",
      "storybook": "^10.5.10",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.66.0",
      "vite": "^8.2.1",
      "vitest": "^4.1.10"
   },
   "engines": {
      "node": "22.x"
   }
}
